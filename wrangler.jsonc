{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personalitytest",
  "main": "./worker.mjs",
  "compatibility_date": "2026-09-13",
  "assets": {
    "directory": "./.cloudflare-stage",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html"],
    "html_handling": "none",
    "not_found_handling": "404-page"
  }
}
